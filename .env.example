# Salin file ini menjadi web/.env.local lalu isi nilainya. JANGAN commit file .env*.
# Di Vercel: isi di Project Settings -> Environment Variables.

# Gemini API (ambil API key di https://aistudio.google.com/apikey)
# Jika dikosongkan, aplikasi tetap jalan dengan rekomendasi cadangan berbasis aturan.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# Tingkat "berpikir" Gemini: minimal / low / medium / high (low = cepat)
GEMINI_THINKING_LEVEL=low
LLM_TIMEOUT_SECONDS=45
# Batas request ke LLM per jam (menjaga kuota selama penjurian)
LLM_MAX_REQUESTS_PER_HOUR=60

# Database Postgres. Kosongkan untuk lokal (otomatis memakai PGlite di folder .data).
# Di Vercel: isi otomatis saat menghubungkan database Neon (Storage -> Neon).
DATABASE_URL=

# Login. AUTH_SECRET = teks acak panjang (min. 32 karakter), wajib di production.
# Buat dengan: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=
# Akun demo untuk guru/juri (jangan tulis password asli di repository)
DEMO_USERNAME=
DEMO_PASSWORD=

# Isi 40 siswa contoh (sintetis) saat database masih kosong: true/false
SEED_DEMO=true
